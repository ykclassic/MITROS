# MITROS deployment/configuration contract
# Never place real credentials in this file.

MITROS_ENVIRONMENT=development
MITROS_EXECUTION_MODE=paper
MITROS_LIVE_TRADING_ENABLED=false
MITROS_LIVE_TRADING_ACK=

# Backend/database — server-side only
MITROS_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Market-data provider credentials — server/worker only
MITROS_MARKET_TWELVEDATA_API_KEY=
MITROS_MARKET_FINNHUB_API_KEY=
MITROS_MARKET_ALPHAVANTAGE_API_KEY=
MITROS_MARKET_FRESHNESS_SECONDS=120

# Application/service security — server-side only
MITROS_APP_SECRET=
MITROS_APPROVAL_SECRET=
MITROS_INTERNAL_API_SECRET=

# Browser/API routing — non-secret
MITROS_FRONTEND_URL=
MITROS_ALLOWED_ORIGINS=

# Observability
MITROS_LOG_LEVEL=INFO
MITROS_LOG_FORMAT=json

# Reserved for the isolated MT5 execution service; do not populate until that
# service is explicitly deployed and approved for live execution.
# MITROS_MT5_LOGIN=
# MITROS_MT5_SERVER=
# MITROS_MT5_PASSWORD=
# MITROS_MT5_TERMINAL_PATH=
