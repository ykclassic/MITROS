# MITROS deployment/configuration contract
# Never place real credentials in this file.

MITROS_ENVIRONMENT=development
MITROS_EXECUTION_MODE=paper
MITROS_LIVE_TRADING_ENABLED=false
MITROS_LIVE_TRADING_ACK=
MITROS_XT_LIVE_ORDERS_ENABLED=false
MITROS_XT_PROTECTION_MONITOR_ENABLED=false
MITROS_XT_PROTECTION_POLL_SECONDS=5

# Backend/database — server-side only
MITROS_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# XT.com authoritative account for the current building phase — server-side only
MITROS_XT_API_KEY=
MITROS_XT_API_SECRET=
MITROS_XT_BASE_URL=https://sapi.xt.com
MITROS_ACCOUNT_EXCHANGE=xt.com
MITROS_XT_ACCOUNT_SCOPE_ID=xt.com:primary
MITROS_XT_ACCOUNT_TYPE=spot

# Market-data provider credentials — server/worker only
MITROS_MARKET_TWELVEDATA_API_KEY=
MITROS_MARKET_FINNHUB_API_KEY=
MITROS_MARKET_ALPHAVANTAGE_API_KEY=
MITROS_MARKET_FRESHNESS_SECONDS=120

# Phase 4 risk policy — all values must be configured server-side before evaluation.
# No policy defaults are silently applied by the API.
MITROS_RISK_MAX_RISK_PER_TRADE=0.01
MITROS_RISK_MAX_POSITION_FRACTION=0.20
MITROS_RISK_MAX_GROSS_EXPOSURE_FRACTION=1.0
MITROS_RISK_MAX_DAILY_LOSS_FRACTION=0.03
MITROS_RISK_MAX_DRAWDOWN_FRACTION=0.10
MITROS_RISK_MAX_ASSET_CONCENTRATION_FRACTION=0.30
MITROS_RISK_MAX_CORRELATED_POSITIONS=2
MITROS_RISK_MAX_CORRELATED_EXPOSURE_FRACTION=0.40
MITROS_RISK_MAX_OPEN_POSITIONS=5
MITROS_RISK_MIN_RISK_REWARD=2
MITROS_RISK_MAX_SPREAD_FRACTION=0.002
MITROS_RISK_MAX_SLIPPAGE_FRACTION=0.001
MITROS_RISK_MIN_DATA_QUALITY=0.90
MITROS_RISK_MAX_QUOTE_AGE_SECONDS=60
MITROS_RISK_MAX_ACCOUNT_AGE_SECONDS=120
MITROS_RISK_MAX_MARKET_PRICE_DEVIATION_FRACTION=0.01

# Application/service security — server-side only
MITROS_APP_SECRET=
MITROS_APPROVAL_SECRET=
MITROS_INTERNAL_API_SECRET=

# Browser/API routing — non-secret
MITROS_FRONTEND_URL=
MITROS_ALLOWED_ORIGINS=

# Observability
MITROS_LOG_LEVEL=INFO
MITROS_LOG_FORMAT=json

# Reserved for the isolated MT5 execution service; do not populate until that
# service is explicitly deployed and approved for live execution.
# MITROS_MT5_LOGIN=
# MITROS_MT5_SERVER=
# MITROS_MT5_PASSWORD=
# MITROS_MT5_TERMINAL_PATH=
